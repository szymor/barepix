[Unit]
Description=BarePix Photo Gallery
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/barepix
ExecStart=/opt/barepix/.venv/bin/python -m barepix
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
